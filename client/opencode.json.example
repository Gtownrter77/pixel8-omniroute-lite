{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://YOUR_CLOUD_HOST:20128/v1",
        "apiKey": "YOUR_OMNIROUTE_API_KEY"
      },
      "models": {
        "auto/cheap": { "name": "auto/cheap" },
        "auto/offline": { "name": "auto/offline" },
        "auto": { "name": "auto" }
      }
    }
  }
}
